post_install() {
  echo ">> Run 'omacmd install' as your user to enable macOS shortcuts."
}

post_upgrade() {
  echo ">> omacmd updated. Reload Hyprland (hyprctl reload) and run 'omarchy restart shell'."
}

pre_remove() {
  echo ">> Run 'omacmd uninstall' as your user first to remove the hooks from ~/.config."
}
