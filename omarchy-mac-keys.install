post_install() {
  echo ">> Run 'mac-keys install' as your user to enable macOS shortcuts."
}

post_upgrade() {
  echo ">> mac-keys updated. Reload Hyprland (hyprctl reload) and run 'omarchy restart shell'."
}

pre_remove() {
  echo ">> Run 'mac-keys uninstall' as your user first to remove the hooks from ~/.config."
}
